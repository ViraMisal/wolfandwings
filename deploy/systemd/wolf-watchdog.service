[Unit]
Description=Wolf and Wings — API watchdog (healthz → Telegram)
After=network-online.target wolf-api.service
Wants=network-online.target

[Service]
Type=oneshot
User=wolf-api
Group=wolf-api
EnvironmentFile=/etc/wolfandwings/api.env
StateDirectory=wolf-watchdog
ExecStart=/usr/local/lib/wolf-watchdog.sh

# --- Hardening ---
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectClock=true
ProtectHostname=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
